PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your_publishable_or_anon_key

# Community orchestrator (Supabase Edge Function URL for the static site)
PUBLIC_COMMUNITY_ORCHESTRATOR_URL=https://YOUR_PROJECT.supabase.co/functions/v1/community-orchestrator

# Set only in Supabase Edge Function secrets (never commit real values):
# CURSOR_API_KEY — Cursor Cloud Agents API key (Basic auth username)
# SUPABASE_SERVICE_ROLE_KEY — service role for orchestrator DB writes
# EDIT_CODE_PEPPER — optional extra secret mixed into edit-code SHA-256 hashes
# COMMUNITY_REPO_URL — optional; defaults to https://github.com/J-V-Studios/grip-site
