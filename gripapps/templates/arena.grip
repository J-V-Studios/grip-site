meta {
  title "Arena"
  blurb "Minimal canvas play scene — extend with sprites and score."
  theme lilgrip_default
}

state {
  score 0
  player_x 80
  player_y 90
}

scene game {
  vibe deep_space motion pulse
  stack {
    canvas {
      clear "#1e1e2e"
      sprite player emoji "🚀"
      score_hud
      particles
    }
    button boost label "boost!" -> action boost
  }
}

action boost {
  set player_x 140
  set player_y 40
  set score 1
  toast "boost engaged — rocket go brr"
}
