meta {
  title "Tap Counter"
  blurb "One tap stores score 1 and shows a toast. set replaces the value; it does not add."
  theme lilgrip_default
}

state {
  score 0
}

scene home {
  stack {
    text "score starts at 0 — tap stores 1 (not a running total)"
    button tap label "tap me" -> action tap
  }
}

action tap {
  set score 1
  toast "nice tap! score is 1"
  goto home
}
