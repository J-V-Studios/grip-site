---
const cards = [
	{
		href: "/church-apps",
		kicker: "faith",
		title: "Church Apps",
		copy: "Holy tools. Unholy amounts of chill.",
		kickerClass: "text-peach",
		hoverBorder: "hover:border-sky/50 focus-visible:border-sky/50",
	},
	{
		href: "/fun-apps",
		kicker: "play",
		title: "Fun Apps",
		copy: "Games, bits, and questionable experiments.",
		kickerClass: "text-mauve",
		hoverBorder: "hover:border-mauve/55 focus-visible:border-mauve/55",
	},
	{
		href: "/about",
		kicker: "lore",
		title: "About",
		copy: "Who is the lilgriper. Why the shades. Etc.",
		kickerClass: "text-teal",
		hoverBorder: "hover:border-teal/50 focus-visible:border-teal/50",
	},
	{
		href: "/money",
		kicker: "hmm",
		title: "Money??",
		copy: "Financial vibes. Maybe. Eventually. Lol.",
		kickerClass: "text-peach",
		hoverBorder: "hover:border-peach/55 focus-visible:border-peach/55",
	},
];
---

<section
	id="explore"
	class="motion-rise mx-auto w-[min(1100px,calc(100%-1.5rem))] pt-10 pb-14 max-[820px]:w-[min(560px,calc(100%-1.2rem))]"
	style="animation-delay: 0.1s"
	aria-labelledby="explore-title"
>
	<div class="mb-6">
		<h2
			id="explore-title"
			class="m-0 mb-2 text-[0.78rem] font-semibold tracking-[0.2em] text-mauve uppercase"
		>
			explore
		</h2>
		<p class="m-0 max-w-[34rem] text-[1.1rem] text-subtext">
			Pick a path. No wrong answers. Maybe wrong answers. Whatever.
		</p>
	</div>
	<div class="grid grid-cols-1 gap-4 min-[821px]:grid-cols-2">
		{
			cards.map((card) => (
				<a
					href={card.href}
					class={`motion-explore group grid min-h-40 gap-[0.5rem] rounded-[1.35rem] border border-white/10 bg-surface/65 px-[1.35rem] py-[1.25rem] no-underline shadow-none transition-[border-color,background,box-shadow] duration-300 hover:bg-surface-soft/90 hover:shadow-[0_18px_50px_rgba(0,0,0,0.35)] focus-visible:bg-surface-soft/90 focus-visible:outline-none ${card.hoverBorder}`}
				>
					<span
						class={`text-[0.72rem] font-semibold tracking-[0.16em] uppercase ${card.kickerClass}`}
					>
						{card.kicker}
					</span>
					<strong class="text-[clamp(1.35rem,2.4vw,1.75rem)] font-bold tracking-[-0.03em] text-text">
						{card.title}
					</strong>
					<span class="text-[0.98rem] leading-[1.45] text-subtext">
						{card.copy}
					</span>
					<span class="mt-auto pt-2 text-[0.78rem] font-semibold tracking-[0.14em] text-sky uppercase">
						yeet →
					</span>
				</a>
			))
		}
	</div>
</section>
