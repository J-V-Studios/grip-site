---
interface Props {
	eyebrow: string;
	title: string;
	lede: string;
	message: string;
}

const { eyebrow, title, lede, message } = Astro.props;
---

<section
	class="motion-rise max-w-[40rem] py-[clamp(2rem,6vh,4rem)] pb-8"
>
	<p
		class="m-0 mb-[0.85rem] text-[0.78rem] font-semibold tracking-[0.2em] text-mauve uppercase"
	>
		{eyebrow}
	</p>
	<h1
		class="m-0 font-sans text-[clamp(2.4rem,7vw,4rem)] leading-[0.92] font-bold tracking-[-0.05em]"
	>
		{title}
	</h1>
	<p class="m-0 mt-4 max-w-[34rem] text-[1.05rem] text-subtext">
		{lede}
	</p>
	<div
		class="mt-8 rounded-[var(--radius,1rem)] border border-surface-soft/80 bg-surface/75 px-6 py-8"
	>
		<p
			class="m-0 mb-5 font-display text-[clamp(1.25rem,3vw,1.6rem)] leading-snug text-text"
		>
			{message}
		</p>
		<a
			href="/"
			class="inline-flex min-h-11 items-center rounded-full bg-sky px-[1.1rem] py-[0.65rem] font-bold text-base no-underline transition-[transform,box-shadow] duration-[250ms] ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-0.5 hover:shadow-[0_10px_30px_rgba(137,220,235,0.28)] focus-visible:-translate-y-0.5 focus-visible:shadow-[0_10px_30px_rgba(137,220,235,0.28)] focus-visible:outline-none"
		>
			Back to Home
		</a>
	</div>
</section>
