---
import { resume } from "../data/resume";

const navLinks = [
	{ href: "/#about-title", label: "About" },
	{ href: "/#experience", label: "Experience" },
	{ href: "/#projects-title", label: "Projects" },
	{ href: "/#skills-title", label: "Skills" },
	{ href: "/#contact", label: "Contact" },
];
---

<header
	class="sticky top-0 z-30 border-b border-line/70 bg-paper/85 backdrop-blur-md"
>
	<div
		class="mx-auto flex w-[min(1080px,calc(100%-1.5rem))] flex-wrap items-center justify-between gap-x-6 gap-y-3 py-3"
	>
		<a
			href="/"
			class="font-display text-[1.2rem] font-semibold tracking-[-0.02em] text-ink no-underline"
		>
			{resume.name}
		</a>
		<nav class="flex flex-wrap gap-x-1 gap-y-1" aria-label="Primary">
			{
				navLinks.map(({ href, label }) => (
					<a
						href={href}
						class="rounded-md px-3 py-2 text-[0.92rem] font-medium text-muted no-underline transition-colors hover:bg-sky-soft hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky"
					>
						{label}
					</a>
				))
			}
		</nav>
	</div>
</header>
