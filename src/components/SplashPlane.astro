---
---

<section
	class="relative isolate min-h-[min(100svh,940px)] overflow-hidden border-b border-white/5"
	aria-label="the lilgriper splash"
>
	<div
		class="motion-sky-drift pointer-events-none absolute -inset-[18%] bg-[radial-gradient(circle_at_50%_35%,rgba(137,220,235,0.28),transparent_42%),radial-gradient(circle_at_15%_80%,rgba(137,180,250,0.22),transparent_45%),radial-gradient(circle_at_90%_20%,rgba(203,166,247,0.2),transparent_40%),radial-gradient(circle_at_80%_85%,rgba(250,179,135,0.14),transparent_35%)]"
		aria-hidden="true"
	>
	</div>
	<div
		class="pointer-events-none absolute inset-0 bg-[linear-gradient(180deg,rgba(30,30,46,0.15)_0%,rgba(30,30,46,0.55)_55%,rgba(30,30,46,0.92)_100%)]"
		aria-hidden="true"
	>
	</div>

	<div
		class="relative z-10 mx-auto grid min-h-[min(100svh,940px)] w-[min(1100px,calc(100%-1.5rem))] grid-cols-1 items-end gap-8 px-1 pt-8 pb-12 max-[820px]:w-[min(560px,calc(100%-1.2rem))] min-[821px]:grid-cols-[minmax(0,1fr)_minmax(280px,460px)] min-[821px]:items-center min-[821px]:pb-16"
	>
		<div class="motion-rise order-2 min-w-0 min-[821px]:order-1">
			<p
				class="m-0 mb-3 text-[0.78rem] font-semibold tracking-[0.22em] text-mauve uppercase"
			>
				lilgrip.com
			</p>
			<h1
				class="m-0 font-sans text-[clamp(3rem,9vw,6.2rem)] leading-[0.9] font-bold tracking-[-0.055em]"
			>
				the <span class="text-sky">lilgriper</span>
			</h1>
			<p
				class="mt-4 mb-0 text-[clamp(1.2rem,2.4vw,1.55rem)] font-medium text-peach"
			>
				just a chill guy · deal with it
			</p>
			<p
				class="mt-5 max-w-[28rem] text-[0.95rem] leading-relaxed text-subtext"
			>
				<span class="text-teal">1 Cor 16:14</span> — Let all that you do be
				done in love. (yes, even the goofy parts.)
			</p>
			<div class="mt-8 flex flex-wrap gap-3">
				<a
					href="#explore"
					class="inline-flex min-h-12 items-center rounded-full bg-sky px-[1.25rem] py-3 text-[0.95rem] font-bold text-base no-underline transition-[transform,box-shadow] duration-200 hover:-translate-y-0.5 hover:shadow-[0_12px_32px_rgba(137,220,235,0.3)] focus-visible:-translate-y-0.5 focus-visible:outline-none"
				>
					explore the chaos
				</a>
				<a
					href="#say-hey"
					class="inline-flex min-h-12 items-center rounded-full border border-white/15 bg-surface/60 px-[1.25rem] py-3 text-[0.95rem] font-semibold text-text no-underline transition-[transform,background] duration-200 hover:-translate-y-0.5 hover:bg-surface-soft focus-visible:-translate-y-0.5 focus-visible:outline-none"
				>
					say hey
				</a>
			</div>
		</div>

		<figure
			class="motion-rise order-1 m-0 justify-self-center min-[821px]:order-2 min-[821px]:justify-self-end"
			style="animation-delay: 0.08s"
		>
			<div
				class="motion-meme-float motion-glint relative w-[min(420px,78vw)] overflow-hidden rounded-[2rem] border border-white/15 bg-surface-soft shadow-[0_28px_80px_rgba(0,0,0,0.45)]"
			>
				<img
					src="/images/lilgrip-meme.png"
					width="945"
					height="945"
					alt="the lilgriper meme face with deal-with-it sunglasses"
					class="aspect-square w-full object-cover"
				/>
			</div>
			<figcaption
				class="mt-3 text-center text-[0.75rem] font-semibold tracking-[0.16em] text-subtext uppercase min-[821px]:text-right"
			>
				official face of chill
			</figcaption>
		</figure>
	</div>
</section>
